{
  "name": "model-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/api/index.ts",
    "test": "node --test \"src/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-path .prettierignore \"src/**/*.ts\" \"*.json\" \"config.json\"",
    "format:check": "prettier --check --ignore-path .prettierignore \"src/**/*.ts\" \"*.json\" \"config.json\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
