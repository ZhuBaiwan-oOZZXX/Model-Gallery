{
  "version": 2,
  "builds": [{
    "src": "src/api/index.ts",
    "use": "@vercel/node",
    "config": {
      "includeFiles": "src/**"
    }
  }],
  "routes": [
    { "src": "/", "dest": "/src/api/index.ts" },
    { "src": "/favicon.svg", "dest": "/src/api/index.ts" },
    { "src": "/(.*)", "dest": "/src/api/index.ts" }
  ]
}
